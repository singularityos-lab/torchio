#
# Per-user systemd service for torchiod. Install under
# ~/.config/systemd/user/ (or /usr/lib/systemd/user/ in the image) and start
# with: systemctl --user enable --now torchiod.service
#
# torchiod is rootless by design (principle P4): it runs entirely in the user
# session, holds no capabilities, and its only API is the control socket under
# XDG_RUNTIME_DIR. Socket activation (Type=notify + a .socket unit) is a future
# refinement; this unit runs the daemon directly.

[Unit]
Description=Torchio print spooler (per-user)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/torchio daemon
Restart=on-failure
RestartSec=2
# Minimal hardening: the daemon needs no privileges and writes only under
# the user's XDG state and runtime directories.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/torchio %t/torchio

[Install]
WantedBy=default.target
